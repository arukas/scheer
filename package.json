{
  "name": "scheer",
  "version": "0.1.0",
  "description": "私有化分发的 Chrome 扩展（MV3），用于在浏览商品页时一键采集商品信息并推送到用户自有的后端服务。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wxt-dev/module-react": "^1.1.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.3",
    "wxt": "^0.19.0"
  },
  "packageManager": "pnpm@8.15.0"
}
