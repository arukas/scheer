{
  "name": "scheer",
  "version": "0.1.1",
  "description": "私有化分发的 Chrome 扩展（MV3），用于在浏览商品页时一键采集商品信息并推送到用户自有的后端服务。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "tsx scripts/build.ts",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "upload": "tsx scripts/upload.ts",
    "build:upload": "wxt build && wxt zip && npm run upload",
    "zip:upload": "wxt zip && npm run upload",
    "compile": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wxt-dev/module-react": "^1.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.3",
    "wxt": "^0.19.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --check",
    "*.{ts,tsx}": "eslint"
  },
  "packageManager": "pnpm@8.15.0"
}
