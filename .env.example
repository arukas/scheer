# S3 / OSS 上传配置
# 复制本文件为 .env.local 并填写真实值，upload / build:upload / zip:upload 脚本会读取

# 对象存储 endpoint，S3 兼容即可
# 阿里云 OSS 示例：https://oss-cn-hangzhou.aliyuncs.com
# AWS S3 示例：https://s3.amazonaws.com
# MinIO 示例：http://localhost:9000
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# 区域
S3_REGION=cn-hangzhou

# Bucket 名称
S3_BUCKET=your-bucket

# Access Key / Secret Key
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# 上传路径前缀，默认 scheer
S3_PATH_PREFIX=scheer

# 是否同时上传 dist/chrome-mv3/ 目录，默认 false
S3_UPLOAD_DIR=false

# 是否使用 path-style endpoint（MinIO 等私有部署通常需要），默认 false
S3_FORCE_PATH_STYLE=false

# 构建后是否自动上传（build 完成后自动 zip + upload），默认 false
S3_AUTO_UPLOAD=false

# 公开访问链接前缀，配置后 build/upload 会打印可访问 URL
# 阿里云 OSS 自定义域名示例：https://cdn.example.com
# Cloudflare R2 默认示例：https://pub-<hash>.r2.dev
# AWS S3 示例：https://your-bucket.s3.your-region.amazonaws.com
S3_PUBLIC_URL=
